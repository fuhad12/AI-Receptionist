# --- Supabase (Project Settings > API) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# the service_role key. Keep it secret, server only.

# --- Vapi (dashboard.vapi.ai > API Keys) ---
VAPI_API_KEY=
# PRIVATE key: used by create-assistant only

VAPI_PUBLIC_KEY=
# PUBLIC key: used by the browser demo page

# --- Your server ---
PUBLIC_URL= # no trailing slash. Use ngrok while testing.
WEBHOOK_SECRET=
# long random string; Vapi sends it with every webhook
ADMIN_KEY=
# long random string; the password for /dashboard
PORT=3000
